# Copy to .env (docker compose) and backend/.env (running the backend directly). NEVER commit real values.
# Generate secrets:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- docker compose ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Fernet key for encrypting conversation text. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=generate-a-fernet-key

# --- backend (backend/.env when not using compose) ---
# ENV=local            # local | test | staging | production
# DATABASE_URL=postgresql+asyncpg://finscore:change-me@localhost:5432/finscore
# JWT_SECRET=...
# DATA_ENCRYPTION_KEY=...
# AI_PROVIDER=none          # none | anthropic (needs ANTHROPIC_API_KEY; spend requires approval)
# ANTHROPIC_API_KEY=
# COOKIE_SECURE=false  # must be true in staging/production
# CORS_ORIGINS=["http://localhost:3000"]
# FRONTEND_URL=http://localhost:3000
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_DIR=../.localdata/mail   # local dev only: write emails to files when no SMTP server

# --- frontend ---
# BACKEND_URL=http://localhost:8000
