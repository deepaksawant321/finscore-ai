# Copy to .env (docker compose) and backend/.env (running the backend directly). NEVER commit real values.
# Generate secrets:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- docker compose ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Fernet key for encrypting conversation text. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=generate-a-fernet-key

# --- backend (backend/.env when not using compose) ---
# ENV=local            # local | test | staging | production
# DATABASE_URL=postgresql+asyncpg://finscore:change-me@localhost:5432/finscore
# JWT_SECRET=...
# DATA_ENCRYPTION_KEY=...
# AI_PROVIDER=none          # none | anthropic (needs ANTHROPIC_API_KEY; spend requires approval)
# ANTHROPIC_API_KEY=
# COOKIE_SECURE=false  # must be true in staging/production
# CORS_ORIGINS=["http://localhost:3000"]
# FRONTEND_URL=http://localhost:3000
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_DIR=../.localdata/mail   # local dev only: write emails to files when no SMTP server
# PURGE_SCHEDULER_ENABLED=true    # runs erasure purge in-process on a timer (K-25); safe to enable on every instance
# PURGE_INTERVAL_SECONDS=3600     # how often it runs (placeholder cadence, minimum 60)
# Client address for rate limits and the audit log (backend/app/infra/clientip.py). Keep FORWARDED_HOPS=0 unless a load
# balancer/CDN that APPENDS the real client address to X-Forwarded-For sits in front of the frontend; then set it to 1 and
# list that proxy's network in TRUSTED_PROXIES. Always run uvicorn with --no-proxy-headers.
# TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]
# FORWARDED_HOPS=0
# PARTNER_RATE_PER_KEY_PER_MINUTE=120  # partner API burst limit per API key, every plan (placeholder)
# PARTNER_RATE_PER_IP_PER_MINUTE=600   # partner API limit per client address, checked before the key (placeholder)

# --- frontend ---
# BACKEND_URL=http://localhost:8000
